# Serves the built web app over HTTPS and forwards /api to the gateway (the browser never
# talks to services directly). Plan C4-03. The nginx image fills ${HTTPS_PORT} from the
# environment when it starts (templates in /etc/nginx/templates/).

# Plain HTTP only redirects.
server {
  listen 80;
  return 301 https://$host:${HTTPS_PORT}$request_uri;
}

server {
  listen 443 ssl;
  http2 on;
  root /usr/share/nginx/html;

  # A mounted certificate, or the self-signed one 10-tls-cert.sh makes at first start.
  ssl_certificate     /etc/nginx/tls/cert.pem;
  ssl_certificate_key /etc/nginx/tls/key.pem;
  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache   shared:TLS:10m;

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;
  # React Flow sets inline styles; no inline scripts are used.
  add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'" always;

  location /api/ {
    proxy_pass http://gateway:8000/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }

  location / {
    try_files $uri /index.html;
  }
}
