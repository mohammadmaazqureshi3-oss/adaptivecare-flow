{
  "id": "triage",
  "version": 3,
  "name": "Emergency triage",
  "variables": [
    {"name": "patient_id", "type": "string"},
    {"name": "age", "type": "int"},
    {"name": "sex", "type": "string"},
    {"name": "arrival_mode", "type": "string"},
    {"name": "chief_complaint", "type": "string"},
    {"name": "spo2", "type": "int"},
    {"name": "sbp", "type": "int"},
    {"name": "hr", "type": "int"},
    {"name": "rr", "type": "int"},
    {"name": "temp", "type": "float"},
    {"name": "pain", "type": "int"},
    {"name": "mental", "type": "string"},
    {"name": "oxygen", "type": "bool"},
    {"name": "news2", "type": "int"},
    {"name": "news2_risk", "type": "string"},
    {"name": "urgency", "type": "int"},
    {"name": "confidence", "type": "float"},
    {"name": "triage_note", "type": "string"},
    {"name": "confirmed_urgency", "type": "int"}
  ],
  "nodes": [
    {"id": "start", "type": "start", "label": "Patient registered", "trigger": "PatientRegistered",
     "inputs": ["patient_id", "age", "sex", "arrival_mode", "chief_complaint"]},
    {"id": "vitals", "type": "task", "kind": "human", "role": "nurse", "label": "Measure vital signs",
     "inputs": ["patient_id", "chief_complaint"],
     "outputs": ["spo2", "sbp", "hr", "rr", "temp", "pain", "mental", "oxygen"],
     "deadline": {"minutes": 10, "escalation": [{"role": "charge_nurse", "afterMin": 5}]},
     "duration": {"dist": "lognormal", "meanMin": 6, "sdMin": 2}},
    {"id": "news2", "type": "task", "kind": "service", "service": "News2Score", "label": "Early warning score (NEWS2)",
     "inputs": ["rr", "spo2", "oxygen", "sbp", "hr", "temp", "mental"],
     "outputs": ["news2", "news2_risk"],
     "retry": {"max": 2, "baseDelayS": 1}, "fallback": "manual_news2",
     "duration": {"dist": "fixed", "meanMin": 0.05}},
    {"id": "manual_news2", "type": "task", "kind": "human", "role": "nurse", "label": "Calculate NEWS2 by hand",
     "inputs": ["patient_id", "rr", "spo2", "oxygen", "sbp", "hr", "temp", "mental"],
     "outputs": ["news2", "news2_risk"],
     "duration": {"dist": "lognormal", "meanMin": 2, "sdMin": 0.5}},
    {"id": "merge_news", "type": "xor_merge", "label": "Score known"},
    {"id": "predict", "type": "task", "kind": "ml", "service": "PredictUrgency", "label": "Predict urgency",
     "inputs": ["age", "sex", "arrival_mode", "chief_complaint", "spo2", "sbp", "hr", "rr", "temp", "pain", "mental"],
     "outputs": ["urgency", "confidence", "triage_note"],
     "retry": {"max": 2, "baseDelayS": 1}, "fallback": "manual_triage",
     "duration": {"dist": "fixed", "meanMin": 0.1}},
    {"id": "manual_triage", "type": "task", "kind": "human", "role": "nurse", "label": "Manual triage (model unavailable)",
     "inputs": ["patient_id", "chief_complaint", "spo2", "sbp", "hr", "rr", "temp", "pain", "mental"],
     "outputs": ["urgency", "confidence", "triage_note"],
     "duration": {"dist": "lognormal", "meanMin": 4, "sdMin": 1.5}},
    {"id": "merge_pred", "type": "xor_merge", "label": "Urgency suggested"},
    {"id": "safety", "type": "xor_split", "label": "Red flags or unsure?"},
    {"id": "confirm_urgent", "type": "task", "kind": "human", "role": "nurse", "label": "Confirm urgency (urgent)",
     "inputs": ["patient_id", "urgency", "triage_note", "news2", "news2_risk", "spo2", "sbp"],
     "outputs": ["confirmed_urgency"],
     "override": {"suggested": "urgency", "decided": "confirmed_urgency"},
     "deadline": {"minutes": 5, "escalation": [{"role": "charge_nurse", "afterMin": 3}]},
     "duration": {"dist": "triangular", "minMin": 1, "modeMin": 2, "maxMin": 4}},
    {"id": "confirm", "type": "task", "kind": "human", "role": "nurse", "label": "Confirm urgency",
     "inputs": ["patient_id", "urgency", "triage_note", "news2", "news2_risk"],
     "outputs": ["confirmed_urgency"],
     "override": {"suggested": "urgency", "decided": "confirmed_urgency"},
     "duration": {"dist": "triangular", "minMin": 1, "modeMin": 2, "maxMin": 3}},
    {"id": "merge_out", "type": "xor_merge", "label": "Urgency confirmed"},
    {"id": "end", "type": "end", "label": "Triage complete", "emit": "TriageCompleted"}
  ],
  "edges": [
    {"from": "start", "to": "vitals"},
    {"from": "vitals", "to": "news2"},
    {"from": "news2", "to": "merge_news"},
    {"from": "manual_news2", "to": "merge_news"},
    {"from": "merge_news", "to": "predict"},
    {"from": "predict", "to": "merge_pred"},
    {"from": "manual_triage", "to": "merge_pred"},
    {"from": "merge_pred", "to": "safety"},
    {"from": "safety", "to": "confirm_urgent", "condition": "spo2 < 90 or sbp < 80 or news2 >= 7 or urgency <= 2 or confidence < 0.7", "prob": 0.4},
    {"from": "safety", "to": "confirm", "default": true, "prob": 0.6},
    {"from": "confirm_urgent", "to": "merge_out"},
    {"from": "confirm", "to": "merge_out"},
    {"from": "merge_out", "to": "end"}
  ]
}
