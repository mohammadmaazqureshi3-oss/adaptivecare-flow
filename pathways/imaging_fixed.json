{
  "id": "imaging_fixed",
  "version": 1,
  "name": "Worked example: the join replaced by a merge (SAFE)",
  "variables": [{"name": "imaging", "type": "string"}],
  "nodes": [
    {"id": "start", "type": "start", "label": "Start"},
    {"id": "register", "type": "task", "kind": "human", "role": "nurse", "label": "Register", "outputs": ["imaging"]},
    {"id": "imaging_type", "type": "xor_split", "label": "Imaging type"},
    {"id": "xray", "type": "task", "kind": "service", "service": "Radiology", "label": "X-ray"},
    {"id": "ct", "type": "task", "kind": "service", "service": "Radiology", "label": "CT"},
    {"id": "wait_both", "type": "xor_merge", "label": "Imaging done"},
    {"id": "end", "type": "end", "label": "End"}
  ],
  "edges": [
    {"from": "start", "to": "register"},
    {"from": "register", "to": "imaging_type"},
    {"from": "imaging_type", "to": "xray", "condition": "imaging == 'xray'"},
    {"from": "imaging_type", "to": "ct", "default": true},
    {"from": "xray", "to": "wait_both"},
    {"from": "ct", "to": "wait_both"},
    {"from": "wait_both", "to": "end"}
  ]
}
