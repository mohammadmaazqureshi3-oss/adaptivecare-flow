{
  "id": "triage",
  "version": 1,
  "name": "Emergency triage",
  "variables": [
    {"name": "patient_id", "type": "string"},
    {"name": "urgency", "type": "int"},
    {"name": "confidence", "type": "float"},
    {"name": "spo2", "type": "int"},
    {"name": "confirmed_urgency", "type": "int"}
  ],
  "nodes": [
    {"id": "start", "type": "start", "label": "Patient registered", "trigger": "PatientRegistered", "inputs": ["patient_id"]},
    {"id": "split1", "type": "and_split", "label": "Predict and measure"},
    {"id": "predict", "type": "task", "kind": "ml", "label": "Predict urgency", "service": "PredictUrgency",
     "inputs": ["patient_id"], "outputs": ["urgency", "confidence"],
     "retry": {"max": 2, "baseDelayS": 1}, "fallback": "manual_triage",
     "duration": {"dist": "fixed", "meanMin": 0.1}},
    {"id": "manual_triage", "type": "task", "kind": "human", "role": "nurse", "label": "Manual triage",
     "inputs": ["patient_id"], "outputs": ["urgency", "confidence"],
     "duration": {"dist": "lognormal", "meanMin": 5, "sdMin": 2}},
    {"id": "merge_pred", "type": "xor_merge", "label": "Urgency known"},
    {"id": "vitals", "type": "task", "kind": "human", "role": "nurse", "label": "Measure vital signs",
     "inputs": ["patient_id"], "outputs": ["spo2"],
     "deadline": {"minutes": 10, "escalation": [{"role": "charge_nurse", "afterMin": 5}]},
     "duration": {"dist": "lognormal", "meanMin": 6, "sdMin": 2}},
    {"id": "join1", "type": "and_join", "label": "Both done"},
    {"id": "urgent", "type": "xor_split", "label": "Urgent?"},
    {"id": "confirm", "type": "task", "kind": "human", "role": "nurse", "label": "Confirm urgent level",
     "inputs": ["urgency"], "outputs": ["confirmed_urgency"],
     "deadline": {"minutes": 5, "escalation": [{"role": "charge_nurse", "afterMin": 3}]},
     "duration": {"dist": "triangular", "minMin": 1, "modeMin": 2, "maxMin": 4}},
    {"id": "waiting", "type": "task", "kind": "human", "role": "nurse", "label": "Confirm and send to waiting room",
     "inputs": ["urgency"], "outputs": ["confirmed_urgency"],
     "duration": {"dist": "triangular", "minMin": 1, "modeMin": 2, "maxMin": 3}},
    {"id": "merge_out", "type": "xor_merge", "label": "Triage done"},
    {"id": "end", "type": "end", "label": "Triage complete"}
  ],
  "edges": [
    {"from": "start", "to": "split1"},
    {"from": "split1", "to": "predict"},
    {"from": "split1", "to": "vitals"},
    {"from": "predict", "to": "merge_pred"},
    {"from": "manual_triage", "to": "merge_pred"},
    {"from": "merge_pred", "to": "join1"},
    {"from": "vitals", "to": "join1"},
    {"from": "join1", "to": "urgent"},
    {"from": "urgent", "to": "confirm", "condition": "urgency <= 2 or spo2 < 90 or confidence < 0.7", "prob": 0.3},
    {"from": "urgent", "to": "waiting", "default": true, "prob": 0.7},
    {"from": "confirm", "to": "merge_out"},
    {"from": "waiting", "to": "merge_out"},
    {"from": "merge_out", "to": "end"}
  ]
}
