# Copy to .env (never commit .env). Development values only.
POSTGRES_USER=adaptivecare
POSTGRES_PASSWORD=change-me-dev-only
RABBITMQ_USER=adaptivecare
RABBITMQ_PASSWORD=change-me-dev-only
DATABASE_URL=postgresql://adaptivecare:change-me-dev-only@postgres:5432/adaptivecare
AMQP_URL=amqp://adaptivecare:change-me-dev-only@rabbitmq:5672/
# At least 32 characters. For anything beyond local development: openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# First admin, created when the auth service starts with an empty user table.
ADMIN_EMAIL=admin@adaptivecare.test
ADMIN_PASSWORD=admin-demo-1
# NFR-SEC-05: encrypts patient names and birth dates. At least 32 characters; a real
# deployment keeps it outside the repository (secret store). Changing it makes stored
# patients unreadable. For anything beyond local development: openssl rand -hex 32
PATIENT_DATA_SECRET=dev-only-patient-secret-change-me-0123456789
# MON-03: when set, /metrics and /metrics.json need it as a bearer token (see monitoring/).
METRICS_TOKEN=
# WRK-03: alert channels. Unset = alerts are only written to the worklist log.
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_FROM=alerts@adaptivecare.test
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMS_URL=
ALERT_SMS_TOKEN=
# Grafana (docker compose --profile monitoring): admin password. Development value only.
GRAFANA_ADMIN_PASSWORD=change-me-dev-only
