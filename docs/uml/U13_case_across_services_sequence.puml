@startuml U13_case_across_services_sequence
!include style.iuml
title U13 — One case across the services (sequence, final: clinical Triage v4)
actor Nurse
participant gateway
participant patient
queue "care.events" as bus
participant "engine.triage.v4" as engine
participant scores
participant ml
participant worklist
participant "engine.assessment.v1" as next

Nurse -> gateway : POST /patients
gateway -> patient : POST /patients
patient -> patient : encrypt name + birth date; save patient\n+ outbox(PatientRegistered) in ONE transaction
patient --> Nurse : 201 P000004
patient ->> bus : relay: PatientRegistered (no name, no birth date)
bus ->> engine : PatientRegistered (trigger matches)
engine -> engine : on_event: lock case, dedupe,\ncase.apply → start
engine -> engine : store event + timers + outbox(CaseStarted,\nTaskRequested) in ONE transaction
engine ->> bus : TaskRequested.worklist (vital signs, deadline 10 min)
bus ->> worklist : task for role nurse
Nurse -> gateway : POST /tasks/{id}/claim, /complete {spo2, sbp, …}
gateway -> worklist
worklist ->> bus : TaskCompleted.triage.v4
bus ->> engine : store outputs; next task
engine ->> bus : TaskRequested.News2Score (+ answer timeout 10 s)
bus ->> scores
scores ->> bus : TaskCompleted {news2, news2_risk}
engine ->> bus : TaskRequested.PredictUrgency (+ answer timeout 10 s)
bus ->> ml
ml ->> bus : TaskCompleted {urgency, confidence, triage_note}
bus ->> engine : decision on live data:\nspo2 < 90 or sbp < 80 or news2 ≥ 7\nor urgency ≤ 2 or confidence < 0.7
engine ->> bus : TaskRequested.worklist (confirm urgency, override check)
Nurse -> worklist : complete; a changed level needs a reason (WRK-02)
worklist ->> bus : TaskCompleted.triage.v4
engine ->> bus : CaseCompleted + TriageCompleted (End announces it)
bus ->> next : TriageCompleted starts the Assessment case
note over bus
  At-least-once delivery: every consumer filters
  duplicates by event_id (I1) and acknowledges
  only after committing. The worklist's monitor
  queue (bound to #) records every event (MON-01).
end note
@enduml
