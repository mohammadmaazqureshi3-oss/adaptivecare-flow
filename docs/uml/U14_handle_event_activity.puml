@startuml U14_handle_event_activity
!include style.iuml
title U14 — Handle an incoming event (activity, final) · EngineService.on_event

start
:event arrives on engine.<pathway>.v<version>\n(or TimerFired from the Scheduler);
if (event is the start trigger?) then (yes)
  if (engine draining? (DEP-02)) then (yes)
    :ignore: no new cases;
    stop
  endif
  :case_id := uuid5(pathway, version, event_id);
else (no)
  :case_id := event.case_id;
endif
:acquire the case's lock (I2);
:BEGIN transaction;
if (event_id already in case_events?) then (yes)
  :ignore (I1);
else (no)
  if (case in memory?) then (yes)
  else (no)
    :latest snapshot + replay of the events after it (I3);
  endif
  if (case not started and event is not the trigger?) then (yes)
    :ignore (unknown case);
  else (no)
    :outbound := case.apply(event)\n(token rules, pure, deterministic ids and times);
    :INSERT case_events(event);
    :TimerScheduled → INSERT timers (kept, not published);\nother outbound → INSERT outbox;
    :UPSERT cases summary;
    if (every 50th event?) then (yes)
      :UPSERT snapshot;
    endif
  endif
endif
:COMMIT (I5) and release the lock;
:acknowledge the message;
:notify the outbox relay → publish;
stop
note right
  An exception before COMMIT rolls everything back,
  drops the in-memory case and lets the broker
  redeliver: nothing is half-applied.
end note
@enduml
