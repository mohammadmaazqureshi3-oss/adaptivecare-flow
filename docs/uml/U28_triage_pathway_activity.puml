@startuml U28_triage_pathway_activity
!include style.iuml
title U28 — Emergency triage v4 (activity, exported from the pathway model)
start
:Patient registered;
note right: started by **PatientRegistered**
:Measure vital signs\n<size:10>nurse</size>;
note right
  writes spo2, sbp, hr, rr, temp, pain, mental, oxygen
  deadline 10 min, escalates to charge_nurse (+5 min)
end note
:Early warning score (NEWS2)\n<size:10>News2Score (service)</size>;
note right
  writes news2, news2_risk
  retries 2× from 1 s, doubling
  no answer in 10 s counts as a failure
  fails for good → fallback **manual_news2**
end note
:Predict urgency\n<size:10>PredictUrgency (ml)</size>;
note right
  writes urgency, confidence, triage_note
  retries 2× from 1 s, doubling
  no answer in 10 s counts as a failure
  fails for good → fallback **manual_triage**
end note
if (Red flags or unsure?) then (spo2 < 90 or sbp < 80 or news2 >= 7 or urgency <= 2 or confidence < 0.7 p=0.4)
  :Confirm urgency (urgent)\n<size:10>nurse</size>;
  note right
    writes confirmed_urgency
    deadline 5 min, escalates to charge_nurse (+3 min)
    changing urgency → confirmed_urgency needs a reason
  end note
else (default p=0.6)
  :Confirm urgency\n<size:10>nurse</size>;
  note right
    writes confirmed_urgency
    changing urgency → confirmed_urgency needs a reason
  end note
endif
:Triage complete;
note right: announces **TriageCompleted**
stop

partition "fallback: Calculate NEWS2 by hand" {
  :Calculate NEWS2 by hand\n<size:10>nurse</size>;
  note right
    writes news2, news2_risk
  end note
  note right: then continues at merge_news
}

partition "fallback: Manual triage (model unavailable)" {
  :Manual triage (model unavailable)\n<size:10>nurse</size>;
  note right
    writes urgency, confidence, triage_note
  end note
  note right: then continues at merge_pred
}
@enduml
